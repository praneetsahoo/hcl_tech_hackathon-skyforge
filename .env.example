# Copy to .env for local runs. No passwords here: the DB password is read
# from SSM Parameter Store using the name in RB_DB_PASSWORD_PARAM.
AWS_REGION=ap-southeast-2
RB_S3_BUCKET=retailbank-data-<account-id>
RB_DB_HOST=<rds-endpoint>
RB_DB_PORT=3306
RB_DB_NAME=retailbank
RB_DB_USER=retailbank_app
RB_DB_PASSWORD_PARAM=/retailbank/db/app_password
RB_LOG_FILE=
